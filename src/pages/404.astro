---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Página No Encontrada (404)" description="La página que buscas no existe o ha sido movida.">
  <Header />
  
  <main class="min-h-[75vh] flex items-center pt-32 pb-20">
    <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8">
      <p class="font-display font-extrabold text-brand-brown/30 leading-none text-[clamp(6rem,20vw,14rem)] [font-variation-settings:'wdth'_75]" aria-hidden="true">404</p>
      <h1 class="mt-2 text-step-3 font-bold">Esta página no existe</h1>
      <p class="mt-5 text-step-1 leading-snug text-brand-blue/80 max-w-[34rem]">
        Puede que el enlace esté mal escrito o que la página se haya movido. Desde el inicio podés llegar a todo el sitio.
      </p>
      <a href="/" class="btn btn-primary mt-10">Volver al inicio</a>
    </div>
  </main>
  
  <Footer />
</Layout>

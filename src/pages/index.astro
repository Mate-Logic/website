---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Philosophy from '../components/Philosophy.astro';
import LocalIdentity from '../components/LocalIdentity.astro';
import Software from '../components/Software.astro';
import Team from '../components/Team.astro';
import Solutions from '../components/Solutions.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import foto from '../assets/images/bernardo.jpeg';

const site = Astro.site!.href;
const fotoFundador = await getImage({ src: foto, width: 400, format: 'jpg' });

// Datos estructurados para que buscadores y asistentes de IA entiendan quiénes somos y qué ofrecemos
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${site}#organizacion`,
      name: 'MateLogic',
      url: site,
      logo: new URL('/apple-touch-icon.png', site).href,
      image: new URL('/og-image.png', site).href,
      slogan: 'Tu idea, nuestra ingeniería',
      description: 'Estudio de desarrollo de software en Chivilcoy, Buenos Aires. Desarrolla aplicaciones web, móviles y de escritorio a medida para empresas de la zona y de cualquier lugar.',
      email: 'contacto@mate-logic.tech',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Chivilcoy',
        addressRegion: 'Buenos Aires',
        addressCountry: 'AR',
      },
      areaServed: [
        { '@type': 'City', name: 'Chivilcoy' },
        { '@type': 'Country', name: 'Argentina' },
      ],
      founder: {
        '@type': 'Person',
        name: 'Bernardo Andrés González Erramuspe',
        jobTitle: 'Fundador y desarrollador full stack',
        image: new URL(fotoFundador.src, site).href,
        knowsAbout: ['C#', '.NET', 'Blazor', 'PHP', 'Java', 'React', 'Astro', 'TypeScript', 'Python', 'SQL Server', 'MySQL', 'Azure', 'Linux', 'Infraestructura', 'Ciberseguridad'],
        alumniOf: { '@type': 'EducationalOrganization', name: 'E.E.S.T. N°1 "Mariano Moreno" de Chivilcoy' },
        affiliation: [
          { '@type': 'CollegeOrUniversity', name: 'Universidad Nacional de Luján' },
          { '@type': 'CollegeOrUniversity', name: 'Universidad Nacional de Tres de Febrero' },
        ],
        memberOf: { '@type': 'Organization', name: 'CODES, Centro Organizado de Estudiantes de Sistemas (UNLu)', url: 'https://www.codesunlu.tech/' },
        sameAs: ['https://github.com/Bernard2806', 'https://www.linkedin.com/in/bernardo-gonzalez-erramuspe/'],
      },
      knowsAbout: ['Desarrollo de software a medida', 'Aplicaciones web', 'Aplicaciones móviles', 'Aplicaciones de escritorio', 'Software open source'],
      sameAs: ['https://github.com/Mate-Logic', 'https://opensource.mate-logic.tech/'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios de desarrollo de software',
        itemListElement: [
          { name: 'Aplicaciones web', description: 'Sistemas en la nube, portales para empresas, tiendas online y sitios institucionales.' },
          { name: 'Aplicaciones Android / iOS', description: 'Apps nativas o híbridas para clientes, herramientas de campo, reservas y turnos.' },
          { name: 'Aplicaciones de escritorio', description: 'Programas a medida para Windows, macOS y Linux: facturación, stock y administración interna.' },
        ].map((service) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', ...service } })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${site}#sitio`,
      url: site,
      name: 'MateLogic',
      inLanguage: 'es-AR',
      publisher: { '@id': `${site}#organizacion` },
    },
  ],
};
---

<Layout title="Inicio" description="MateLogic es un estudio de desarrollo de software en Chivilcoy, Buenos Aires. Hacemos aplicaciones web, móviles y de escritorio a medida para empresas de la zona y de cualquier lugar.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <Header />

  <main>
    <Hero />
    <ServicesGrid />
    <Philosophy />
    <LocalIdentity />
    <Software />
    <Team />
    <Solutions />
  </main>

  <Footer />
</Layout>

---
---
<section id="contacto" class="py-20 md:py-28 bg-brand-blue text-brand-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 items-start">
    <div class="lg:sticky lg:top-28" data-reveal>
      <h2 class="text-step-3 font-bold">Tu idea, nuestra ingeniería</h2>
      <p class="mt-6 text-step-1 leading-snug text-brand-cream/85 max-w-[30rem]">
        Ya sea una plataforma nueva, una consulta técnica o digitalizar algo que hoy hacés a mano, lo charlamos con unos mates.
      </p>
    </div>

    <div class="bg-brand-cream text-brand-blue rounded-[1.75rem] p-6 sm:p-8 md:p-10" data-reveal style="--reveal-delay: 0.1s">
      <form
        id="contact-form"
        class="space-y-6"
        novalidate
        toolname="contactar_matelogic"
        tooldescription="Prepara una consulta para MateLogic, estudio de desarrollo de software en Chivilcoy, Argentina. Arma un mensaje de WhatsApp con los datos del interesado; la persona lo revisa y lo envía."
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block font-bold mb-1.5">Nombre</label>
            <input type="text" id="name" name="name" required autocomplete="name" toolparamdescription="Nombre de la persona que hace la consulta" class="field" placeholder="Juan Pérez">
            <p class="field-error">Decinos cómo te llamás.</p>
          </div>
          <div>
            <label for="email" class="block font-bold mb-1.5">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" toolparamdescription="Email de contacto para la respuesta" class="field" placeholder="juan@empresa.com">
            <p class="field-error">Necesitamos un email válido para responderte.</p>
          </div>
        </div>

        <div>
          <label for="service" class="block font-bold mb-1.5">¿Qué necesitás?</label>
          <select id="service" name="service" toolparamdescription="Tipo de software que necesita" class="field text-brand-blue">
            <option>Aplicación web</option>
            <option>Aplicación Android / iOS</option>
            <option>Aplicación de escritorio</option>
            <option>Todavía no lo sé, quiero asesoramiento</option>
          </select>
        </div>

        <div>
          <label for="message" class="block font-bold mb-1.5">Contanos sobre tu proyecto</label>
          <textarea id="message" name="message" rows="4" required toolparamdescription="Descripción del proyecto: qué problema quiere resolver y cómo trabaja hoy" class="field" placeholder="Me gustaría construir..."></textarea>
          <p class="field-error">Contanos al menos en una línea qué tenés en mente.</p>
        </div>

        <button type="submit" class="btn btn-primary w-full text-lg py-4">
          <span data-label>Enviar por WhatsApp</span>
        </button>
        <p class="text-center text-sm text-brand-blue/60">Se abre WhatsApp con tu mensaje listo. Lo enviás vos cuando quieras.</p>
      </form>
    </div>
  </div>
</section>

<style>
  .field {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in oklab, var(--color-brand-teal) 25%, transparent);
    background: white;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .field:focus {
    outline: none;
    border-color: var(--color-brand-teal);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-brand-teal) 25%, transparent);
  }

  .field-error {
    display: none;
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: #a3402a;
  }

  .field:user-invalid,
  .was-submitted .field:invalid {
    border-color: #a3402a;
  }

  .field:user-invalid + .field-error,
  .was-submitted .field:invalid + .field-error {
    display: block;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    form.addEventListener('submit', (e: SubmitEvent & { agentInvoked?: boolean; respondWith?: (response: Promise<unknown>) => void }) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        // Muestra los errores de todos los campos, aunque la persona no los haya tocado
        form.classList.add('was-submitted');
        form.querySelector<HTMLElement>(':invalid')?.focus();
        if (e.agentInvoked && e.respondWith) {
          e.respondWith(Promise.reject(new Error('Faltan datos: nombre, email válido y descripción del proyecto son obligatorios.')));
        }
        return;
      }

      const data = new FormData(form);
      const text = `¡Hola Bernardo! Soy ${data.get('name')} (${data.get('email')}).

Estoy interesado en: ${data.get('service')}

Mensaje:
${data.get('message')}`;

      const label = form.querySelector<HTMLElement>('[data-label]');
      if (label) {
        label.textContent = 'Abriendo WhatsApp…';
        setTimeout(() => (label.textContent = 'Enviar por WhatsApp'), 2500);
      }

      const whatsappUrl = `https://wa.me/5492346409771?text=${encodeURIComponent(text)}`;

      // Si un agente de IA envió el formulario (WebMCP), le devolvemos el enlace para que la persona lo abra
      if (e.agentInvoked && e.respondWith) {
        e.respondWith(Promise.resolve({ mensaje: 'Consulta lista. Abrí el enlace para enviarla por WhatsApp.', whatsappUrl }));
      }

      window.open(whatsappUrl, '_blank', 'noopener');
    });
  }
</script>

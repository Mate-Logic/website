---
import { Image } from 'astro:assets';
import foto from '../assets/images/bernardo.jpeg';

const skills = ['.NET', 'C#', 'PHP', 'SQL', 'Arquitectura web'];
---
<section id="nosotros" class="py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-step-3 font-bold" data-reveal>Quién está detrás</h2>

    <div class="mt-12 grid gap-10 md:grid-cols-[auto_1fr] md:gap-14 items-start" data-reveal style="--reveal-delay: 0.1s">
      <Image src={foto} alt="Retrato de Bernardo González Erramuspe" width={192} densities={[1, 2]} class="w-36 h-36 md:w-48 md:h-48 rounded-full object-cover bg-white ring-8 ring-brand-sand" />

      <div>
        <h3 class="text-step-2 font-bold">Bernardo Andrés González Erramuspe</h3>
        <p class="mt-1 font-bold text-brand-yerba">Fundador y desarrollador full stack</p>
        <p class="mt-5 text-brand-blue/80 max-w-[60ch]">
          Trabaja con .NET, PHP, C# y bases de datos SQL, con experiencia en arquitecturas que crecen junto con el negocio. En MateLogic se ocupa de que cada proyecto tenga atención personal y un estándar técnico alto.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tecnologías">
          {skills.map((skill) => (
            <li class="text-step--1 px-3 py-1 rounded-full border border-brand-blue/20">{skill}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

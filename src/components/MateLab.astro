---
---
<section id="matelab" class="py-24 bg-brand-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-teal/10 text-brand-teal font-semibold text-xs mb-4 uppercase tracking-wider">
          Investigación & Desarrollo
        </div>
        <h2 class="text-4xl font-bold text-brand-blue mb-4">MateLab</h2>
        <p class="text-lg text-brand-blue/70">
          Nuestro espacio de experimentación. Descubrí herramientas gratuitas, demos de UX/UI y playgrounds de APIs desarrollados por nuestro equipo.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Tool 1 -->
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-brand-teal/10 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        <div class="w-12 h-12 bg-brand-blue/5 rounded-lg flex items-center justify-center text-brand-blue mb-6">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-brand-blue mb-2">CSV Analyzer</h3>
        <p class="text-brand-blue/60 text-sm mb-6 min-h-[60px]">
          Herramienta web rápida para procesar y visualizar grandes volúmenes de datos directamente en el navegador.
        </p>
        <a href="#" class="inline-flex items-center text-brand-teal font-semibold text-sm hover:text-brand-blue transition-colors">
          Probar Demo <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>

      <!-- Tool 2 -->
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-brand-teal/10 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        <div class="w-12 h-12 bg-brand-teal/10 rounded-lg flex items-center justify-center text-brand-teal mb-6">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-brand-blue mb-2">API Playground</h3>
        <p class="text-brand-blue/60 text-sm mb-6 min-h-[60px]">
          Sandbox interactivo para explorar nuestras capacidades de integración y microservicios escalables.
        </p>
        <a href="#" class="inline-flex items-center text-brand-teal font-semibold text-sm hover:text-brand-blue transition-colors">
          Explorar API <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>

      <!-- Tool 3 -->
      <div class="bg-brand-blue rounded-2xl p-8 shadow-sm relative overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 bg-brand-teal/20 rounded-full blur-2xl"></div>
        <div>
          <h3 class="text-2xl font-bold text-brand-cream mb-2">Más en camino</h3>
          <p class="text-brand-cream/70 text-sm mb-6">
            Nuestro equipo de R&D constantemente publica nuevos experimentos y librerías open-source.
          </p>
        </div>
        <a href="https://github.com/Bernard2806" target="_blank" class="w-full text-center px-4 py-3 bg-brand-cream text-brand-blue rounded-lg font-semibold hover:bg-brand-teal hover:text-brand-cream transition-colors">
          Visitar nuestro GitHub
        </a>
      </div>
    </div>
  </div>
</section>

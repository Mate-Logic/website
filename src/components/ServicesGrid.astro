---
const services = [
  {
    title: "Aplicaciones Web",
    description: "Desarrollo de sistemas en la nube, portales corporativos, e-commerce y sitios web de alto rendimiento optimizados para SEO.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>`
  },
  {
    title: "Aplicaciones Android / iOS",
    description: "Creamos experiencias móviles nativas e híbridas que acompañan a tus usuarios a donde vayan, enfocándonos en rendimiento y usabilidad.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`
  },
  {
    title: "Aplicaciones de Escritorio",
    description: "Software local robusto y a medida para Windows, macOS y Linux. Sistemas integrales diseñados para potenciar la gestión de tu empresa.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>`
  }
];
---

<section id="servicios" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-blue mb-4">Soluciones Tecnológicas Integrales</h2>
      <p class="text-lg text-brand-blue/70">
        Combinamos rigor técnico con un enfoque en resolver los problemas reales de tu negocio.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <div 
          class="group p-8 rounded-2xl bg-brand-cream border border-brand-teal/10 hover:border-brand-teal/30 hover:shadow-xl transition-all duration-500 relative overflow-hidden opacity-0 animate-scale-in"
          style={`animation-delay: ${index * 0.2 + 0.2}s; animation-fill-mode: both;`}
        >
          <div class="absolute top-0 right-0 w-32 h-32 bg-brand-teal/5 rounded-bl-full -mr-8 -mt-8 transition-transform duration-700 group-hover:scale-125"></div>
          
          <div class="w-14 h-14 bg-brand-blue text-brand-cream rounded-xl flex items-center justify-center mb-6 shadow-md group-hover:bg-brand-teal group-hover:-translate-y-2 transition-all duration-300">
            <Fragment set:html={service.icon} />
          </div>
          
          <h3 class="text-xl font-bold text-brand-blue mb-3 group-hover:text-brand-teal transition-colors">{service.title}</h3>
          <p class="text-brand-blue/70 leading-relaxed">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

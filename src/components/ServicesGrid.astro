---
const services = [
  {
    title: 'Aplicaciones web',
    description: 'Sistemas en la nube, portales para tu empresa, tiendas online y sitios rápidos, preparados para aparecer en Google.',
    examples: ['Sistemas de gestión', 'Tiendas online', 'Sitios institucionales'],
    icon: `<path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>`,
  },
  {
    title: 'Aplicaciones Android / iOS',
    description: 'Apps nativas o híbridas que acompañan a tus clientes en el celular, rápidas y fáciles de usar.',
    examples: ['Apps para clientes', 'Herramientas de campo', 'Reservas y turnos'],
    icon: `<path d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>`,
  },
  {
    title: 'Aplicaciones de escritorio',
    description: 'Programas a medida para Windows, macOS y Linux que ordenan la gestión diaria de tu empresa.',
    examples: ['Facturación y stock', 'Administración interna', 'Integración con equipos'],
    icon: `<path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
  },
];
---

<section id="servicios" class="py-20 md:py-28 border-t border-brand-brown/25">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr] lg:gap-16 mb-12 md:mb-16" data-reveal>
      <h2 class="text-step-3 font-bold">Qué desarrollamos</h2>
      <p class="text-step-1 leading-snug text-brand-blue/75 max-w-[36rem] lg:pt-2">
        Software pensado para los problemas reales de tu negocio, con el cuidado técnico de un producto que va a durar.
      </p>
    </div>

    <ul class="border-t-2 border-brand-blue">
      {services.map((service, index) => (
        <li
          class="grid gap-4 md:grid-cols-[3rem_minmax(0,1fr)_minmax(0,1.1fr)_13rem] md:gap-10 md:items-start py-8 md:py-10 border-b border-brand-brown/25"
          data-reveal
          style={`--reveal-delay: ${index * 0.08}s`}
        >
          <span class="flex items-center justify-center w-12 h-12 rounded-full border-2 border-brand-blue text-brand-blue">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <Fragment set:html={service.icon} />
            </svg>
          </span>
          <h3 class="text-step-2 font-bold md:pt-1.5">{service.title}</h3>
          <p class="text-brand-blue/80 md:pt-2 max-w-[38ch]">{service.description}</p>
          <ul class="flex flex-wrap gap-2 md:flex-col md:items-end md:pt-2.5" aria-label={`Ejemplos de ${service.title.toLowerCase()}`}>
            {service.examples.map((example) => (
              <li class="text-step--1 px-3 py-1 rounded-full bg-brand-sand text-brand-blue/90">{example}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>


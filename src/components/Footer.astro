---
const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-blue text-brand-cream pt-16 pb-8 border-t-4 border-brand-green">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- Brand & Description -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-2 group">
          <span class="font-bold text-2xl tracking-tight text-brand-cream">Mate<span class="text-brand-green">Logic</span></span>
        </a>
        <p class="text-brand-cream/80 text-sm max-w-xs leading-relaxed">
          Ingeniería de software con el toque humano que tu proyecto necesita. Con base en Chivilcoy, desarrollando para el mundo.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-brand-cream">Enlaces Rápidos</h3>
        <ul class="space-y-2">
          <li><a href="#servicios" class="text-brand-cream/80 hover:text-brand-green transition-colors text-sm">Servicios</a></li>
          <li><a href="#software" class="text-brand-cream/80 hover:text-brand-green transition-colors text-sm">Software</a></li>
          <li><a href="#nosotros" class="text-brand-cream/80 hover:text-brand-green transition-colors text-sm">Nosotros</a></li>
          <li><a href="#contacto" class="text-brand-cream/80 hover:text-brand-green transition-colors text-sm">Contacto</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-brand-cream">Contacto</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-3 text-sm text-brand-cream/80">
            <svg class="w-5 h-5 text-brand-green shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>Chivilcoy, Buenos Aires<br/>Argentina</span>
          </li>
          <li class="flex items-center gap-3 text-sm text-brand-cream/80">
            <svg class="w-5 h-5 text-brand-green shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:bgonzalezerramuspe2006@proton.me" class="hover:text-brand-green transition-colors text-[13px]">bgonzalezerramuspe2006@proton.me</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-brand-teal/20 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-brand-cream/60 text-xs">
        &copy; {currentYear} MateLogic Interactive. Todos los derechos reservados.
      </p>
      <div class="flex gap-4">
        <a href="https://github.com/Bernard2806" target="_blank" rel="noopener noreferrer" class="text-brand-cream/60 hover:text-brand-green transition-colors">
          <span class="sr-only">GitHub</span>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />

---
import { Image } from 'astro:assets';
import isotipo from '../assets/images/isotipo.png';
---
<section class="relative pt-28 pb-16 md:pt-36 md:pb-24 overflow-x-clip" id="inicio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:gap-16 items-center">
    <div>
      <h1 class="hero-title text-step-4 font-extrabold text-brand-blue animate-fade-in-up">
        Software a medida que empieza con una charla
      </h1>

      <p class="mt-8 max-w-[34rem] text-step-1 leading-snug text-brand-blue/80 animate-fade-in-up [animation-delay:0.15s]">
        MateLogic es un estudio de desarrollo de software en Chivilcoy, Buenos Aires. Hacemos aplicaciones web, móviles y de escritorio para empresas de la zona y de cualquier lugar.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-3 animate-fade-in-up [animation-delay:0.3s]">
        <a href="#contacto" class="btn btn-primary text-lg">Contanos tu proyecto</a>
        <a href="#servicios" class="btn btn-ghost text-lg">Ver servicios</a>
      </div>
    </div>

    <figure class="relative w-full max-w-[220px] sm:max-w-[280px] lg:max-w-[360px] lg:justify-self-end" aria-hidden="true">
      <div class="relative aspect-[424/760]">
        <Image src={isotipo} alt="" width={360} densities={[1, 2]} loading="eager" fetchpriority="high" class="hero-mate absolute top-0 left-0 w-full h-auto" />
        <svg class="absolute inset-0 w-full h-full overflow-visible" viewBox="0 0 424 760" fill="none">
          <g stroke="currentColor" class="text-brand-blue" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
            <path class="trace [--d:0.55s]" pathLength="1" d="M218 538 V600 L172 646 H44" />
            <path class="trace [--d:0.85s]" pathLength="1" d="M218 600 L264 646 V706" />
          </g>
          <g stroke="currentColor" class="text-brand-blue" stroke-width="8">
            <circle class="node fill-brand-cream [--d:1.35s]" cx="32" cy="646" r="12" />
            <circle class="node fill-brand-green [--d:1.55s]" cx="264" cy="720" r="12" />
          </g>
        </svg>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero-title {
    font-variation-settings: 'wdth' 80;
    line-height: 0.95;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }

  .hero-mate {
    animation: mate-in 1s var(--ease-out-quint) 0.1s both;
  }

  .trace {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.8s var(--ease-out-quint) var(--d) forwards;
  }

  .node {
    transform-box: fill-box;
    transform-origin: center;
    animation: node-in 0.5s var(--ease-out-quint) var(--d) both;
  }

  @keyframes mate-in {
    from {
      opacity: 0;
      transform: translateY(12px) rotate(-4deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes node-in {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

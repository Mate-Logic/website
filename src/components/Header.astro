---
import { Image } from 'astro:assets';
import logoImage from '../assets/images/mate-logic-logo-transparent.png';

const links = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#software', label: 'Software' },
  { href: '/#nosotros', label: 'Nosotros' },
];
---
<header id="site-header" class="group/header fixed w-full top-0 z-50 bg-brand-cream/90 backdrop-blur-md border-b border-transparent transition-[border-color,box-shadow] duration-300 data-[scrolled]:border-brand-teal/20 data-[scrolled]:shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-24 transition-[height] duration-300 group-data-[scrolled]/header:h-16">
      <a href="/" class="flex items-center gap-3 group rounded-lg">
        <Image src={logoImage} alt="" width={200} loading="eager" fetchpriority="high" class="h-16 w-auto transition-[height,transform] duration-300 ease-out group-hover:-rotate-3 group-data-[scrolled]/header:h-11" />
        <span class="font-black text-2xl tracking-tighter text-brand-blue">MateLogic</span>
      </a>

      <nav class="hidden md:flex gap-2" aria-label="Principal">
        {links.map(({ href, label }) => (
          <a href={href} class="nav-link relative px-3 py-2 text-sm font-medium text-brand-blue hover:text-brand-teal transition-colors rounded-md">{label}</a>
        ))}
      </nav>

      <a href="/#contacto" class="hidden md:inline-flex bg-brand-blue text-brand-cream hover:bg-brand-teal px-5 py-2.5 rounded-full text-sm font-semibold transition-colors duration-300">
        Contanos tu proyecto
      </a>

      <button type="button" class="md:hidden -mr-2 p-2 rounded-md text-brand-blue hover:text-brand-teal" aria-controls="mobile-menu" aria-expanded="false" id="mobile-menu-btn">
        <span class="sr-only">Abrir menú</span>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="menu-line origin-center transition-transform duration-300" d="M4 6h16" />
          <path class="menu-line origin-center transition-opacity duration-200" d="M4 12h16" />
          <path class="menu-line origin-center transition-transform duration-300" d="M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out bg-brand-cream border-b border-brand-teal/20 data-[open]:grid-rows-[1fr]" inert>
    <div class="overflow-hidden">
      <nav class="px-4 pt-2 pb-5 space-y-1" aria-label="Principal móvil">
        {links.map(({ href, label }) => (
          <a href={href} class="block px-3 py-3 text-base font-medium text-brand-blue hover:bg-brand-teal/10 rounded-md">{label}</a>
        ))}
        <a href="/#contacto" class="block mt-3 px-3 py-3 text-base font-semibold text-brand-cream bg-brand-blue hover:bg-brand-teal rounded-full text-center transition-colors">
          Contanos tu proyecto
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-brand-green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link[aria-current='true']::after {
    transform: scaleX(1);
  }

  [aria-expanded='true'] .menu-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  [aria-expanded='true'] .menu-line:nth-child(2) {
    opacity: 0;
  }

  [aria-expanded='true'] .menu-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (header) {
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('.sr-only')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
      menu.toggleAttribute('data-open', open);
      menu.inert = !open;
    };

    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
  }

  // Marca en el menú la sección que se está leyendo
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const sections = document.querySelectorAll<HTMLElement>('main section[id]');

  if (navLinks.length && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          navLinks.forEach((link) => link.setAttribute('aria-current', String(link.hash === `#${entry.target.id}`)));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

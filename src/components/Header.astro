---
import { Image } from 'astro:assets';
import logoImage from '../assets/images/mate-logic-logo-transparent.png';
---
<header class="fixed w-full top-0 z-50 bg-brand-cream/90 backdrop-blur-md border-b border-brand-teal/20 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-24">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-3 group">
          <Image src={logoImage} alt="MateLogic Logo" width={200} loading="eager" fetchpriority="high" class="h-16 w-auto group-hover:scale-110 group-hover:-rotate-2 transition-transform duration-500 ease-out drop-shadow-md" />
          <span class="font-black text-2xl tracking-tighter text-brand-blue group-hover:text-brand-teal transition-colors">MateLogic</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex space-x-8">
        <a href="#servicios" class="text-brand-blue hover:text-brand-teal px-3 py-2 text-sm font-medium transition-colors">Servicios</a>
        <a href="#software" class="text-brand-blue hover:text-brand-teal px-3 py-2 text-sm font-medium transition-colors">Software</a>
        <a href="#nosotros" class="text-brand-blue hover:text-brand-teal px-3 py-2 text-sm font-medium transition-colors">Nosotros</a>
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:flex items-center">
        <a href="#contacto" class="bg-brand-blue text-brand-cream hover:bg-brand-teal px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
          Tu Idea, Nuestra Ingeniería
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button type="button" class="text-brand-blue hover:text-brand-teal focus:outline-none" aria-controls="mobile-menu" aria-expanded="false" id="mobile-menu-btn">
          <span class="sr-only">Abrir menú principal</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div class="md:hidden hidden bg-brand-cream/95 backdrop-blur-lg border-b border-brand-teal/20 absolute w-full" id="mobile-menu">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      <a href="#servicios" class="block px-3 py-2 text-base font-medium text-brand-blue hover:text-brand-teal hover:bg-brand-teal/5 rounded-md">Servicios</a>
      <a href="#software" class="block px-3 py-2 text-base font-medium text-brand-blue hover:text-brand-teal hover:bg-brand-teal/5 rounded-md">Software</a>
      <a href="#nosotros" class="block px-3 py-2 text-base font-medium text-brand-blue hover:text-brand-teal hover:bg-brand-teal/5 rounded-md">Nosotros</a>
      <a href="#contacto" class="block px-3 py-2 mt-4 text-base font-medium text-brand-cream bg-brand-blue hover:bg-brand-teal rounded-md text-center transition-colors">
        Tu Idea, Nuestra Ingeniería
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>

---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description = "MateLogic - Empresa de desarrollo de software en Chivilcoy. Creamos aplicaciones web, móviles y de escritorio de alta calidad con un toque humano.", image = "/og-image.png" } = Astro.props;
const canonicalURL = Astro.url.href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<meta name="keywords" content="empresa de software, desarrollo de software, software chivilcoy, aplicaciones web, aplicaciones móviles, aplicaciones de escritorio, programación, soluciones digitales, MateLogic">
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${title} | MateLogic - Desarrollo de Software Chivilcoy`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url).href} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | MateLogic - Desarrollo de Software Chivilcoy`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.url).href} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title} | MateLogic - Desarrollo de Software Chivilcoy</title>
	</head>
	<body>
		<slot />
	</body>
</html>
